{
  "name": "dsh-think-zh",
  "version": "1.1.0",
  "description": "强制 DeepSeek Harness 的思考使用简体中文，并可在「设置 → 通用设置」切换",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "cordis",
    "chinese",
    "reasoning",
    "settings"
  ],
  "license": "MIT",
  "author": "Len7183 <Len7183@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Len7183/DSH-Think-zh.git"
  },
  "homepage": "https://github.com/Len7183/DSH-Think-zh#readme",
  "bugs": {
    "url": "https://github.com/Len7183/DSH-Think-zh/issues"
  },
  "type": "module",
  "sideEffects": [
    "./client.js"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests client.js eslint.config.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "~8.46.0",
    "vitest": "^3.0.0"
  }
}
